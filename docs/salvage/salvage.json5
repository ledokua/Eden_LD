// Gear salvage with Create (Eden_LD 1.3.24+; spec: Documents/Minestar/FallenEden/Salvage/SPEC.md).
// Mechanical press: loot gear -> weapon/armor scrap of its power-level tier. Only gear with a Dungeon
// Difficulty power level matches ("eden_ld:power_level" reads custom_data "dd.rsf"); crafted gear has none.
// Crushing wheels: scrap -> a chance of Limit Breaker enhancement stones (+ a small experience nugget chance).
//
// Tune freely and /reload: "min"/"max" are the power-level bands (no "max" = open-ended), "chance" is 0..1.
// Changing a band doesn't change the scrap's tooltip ("From gear of power level 11-20"), which is fixed in
// Eden_LD; keep bands 1-10, 11-20, ... 51+ or tell the Eden_LD session.
{
  "recipes": {
    "add": [
      // ---- Mechanical press: loot gear -> scrap ----
      // weapon scrap I: weapons of power level 1-10
      {
        "id": "eden_ld:salvage/pressing/weapon_scrap_1",
        "type": "create:pressing",
        "ingredients": [
          {
            "fabric:type": "eden_ld:power_level",
            "base": {
              "tag": "falleneden:gear/weapons/all"
            },
            "min": 1,
            "max": 10
          }
        ],
        "results": [
          {
            "id": "eden_ld:weapon_scrap_1"
          }
        ]
      },
      // weapon scrap II: weapons of power level 11-20
